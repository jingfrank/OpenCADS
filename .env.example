# Environment variables for CADS (Chip Anomaly Detection System)
# See README.md for Docker usage instructions

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ads

# Redis
REDIS_URL=redis://redis:6379/0

# Backend
DATABASE_URL=postgresql://postgres:postgres@db:5432/ads
REDIS_URL=redis://redis:6379/0

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: override model weights path
# MODELS_DIR=models

# Optional: override dataset directory
# DATASETS_DIR=datasets